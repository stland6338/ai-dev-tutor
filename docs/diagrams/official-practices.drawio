etry x="960" y="80" width="260" height="130" as="geometry"/></mxCell><mxCell id="c12" value="「コミットして」" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#ffffff;strokeColor=#d0c8bb;fontColor=#667085;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="960" y="225" width="260" height="50" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Hiragino Sans;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#667085;fontColor=#667085;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="diff を1文で説明できるなら Plan は省いてよい。方針が定まらない・複数ファイル・知らないコードなら計画する" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=none;strokeColor=none;fontColor=#667085;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="285" width="1200" height="24" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#f3f1ec;strokeColor=#d0c8bb;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="1230" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;context は最も限られた資源&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=none;strokeColor=none;fontColor=#1f2328;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="45" y="338" width="600" height="26" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;/clear&lt;/b&gt;&lt;br&gt;関係ない次の作業へ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#ffffff;strokeColor=#d0c8bb;fontColor=#1f2328;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="45" y="372" width="228" height="54" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;/compact&lt;/b&gt;&lt;br&gt;履歴を軽くして続ける" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#ffffff;strokeColor=#d0c8bb;fontColor=#1f2328;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="288" y="372" width="228" height="54" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;/rewind&lt;/b&gt;&lt;br&gt;失敗した試みを戻す" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#ffffff;strokeColor=#d0c8bb;fontColor=#1f2328;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="531" y="372" width="228" height="54" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;/btw&lt;/b&gt;&lt;br&gt;履歴に残さない質問" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#ffffff;strokeColor=#d0c8bb;fontColor=#1f2328;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="774" y="372" width="228" height="54" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;/context&lt;/b&gt;&lt;br&gt;中身を見る" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#ffffff;strokeColor=#d0c8bb;fontColor=#1f2328;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1017" y="372" width="228" height="54" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A3 確かめ方の4段階" id="p1"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1290" pageHeight="480" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="確かめ方を渡す: 強制の4段階（Claude Code 2.1.310 時点）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=none;strokeColor=none;fontColor=#1f2328;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:15px'&gt;1 プロンプトに書く&lt;/b&gt;&lt;br&gt;&lt;br&gt;「終える前に npm test を実行して」&lt;br&gt;手軽。忘れられることがある" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#f3f1ec;strokeColor=#d0c8bb;fontColor=#1f2328;fontSize=12;fontStyle=0;align=center;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="280" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:15px'&gt;2 /goal &amp;lt;条件&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;ターンごとに条件を確かめ&lt;br&gt;満たすまで続けさせる" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#fdf3d8;strokeColor=#9a6700;fontColor=#1f2328;fontSize=12;fontStyle=0;align=center;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="330" y="260" width="280" height="180" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:15px'&gt;3 Stop hook&lt;/b&gt;&lt;br&gt;&lt;br&gt;終わろうとするたびにスクリプトが走る&lt;br&gt;必ず実行される（決定的）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#e3f3ea;strokeColor=#1f7a4d;fontColor=#1f2328;fontSize=12;fontStyle=0;align=center;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="630" y="190" width="280" height="250" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:15px'&gt;4 検証 subagent / /code-review&lt;/b&gt;&lt;br&gt;&lt;br&gt;書いた本人以外が&lt;br&gt;別の context で確かめる" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#f7e9e1;strokeColor=#b4532a;fontColor=#1f2328;fontSize=12;fontStyle=0;align=center;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="930" y="120" width="280" height="320" as="geometry"/></mxCell><mxCell id="c7" value="Claude の注意に頼らないほど強い" style="html=1;fontFamily=Hiragino Sans;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#b4532a;fontColor=#b4532a;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="460" as="sourcePoint"/><mxPoint x="1240" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="何度も同じことを頼んでいるなら、hook にする合図" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=none;strokeColor=none;fontColor=#667085;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="700" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A6 守り方の比較" id="p2"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1290" pageHeight="400" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="守り方の比較（Claude Code 2.1.310 時点）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=none;strokeColor=none;fontColor=#1f2328;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:15px'&gt;CLAUDE.md に書く&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#f3f1ec;strokeColor=#d0c8bb;fontColor=#1f2328;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="280" height="60" as="geometry"/></mxCell><mxCell id="c4" value="頼るもの: &lt;b&gt;Claude の注意&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Hiragino Sans;fillColor=#ffffff;strokeColor=#d0c8bb;fontColor=