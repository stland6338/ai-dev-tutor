{
  "permissions": {
    "allow": ["Bash(npm test *)", "Bash(npm run *)", "mcp__claude-code-docs__*"],
    "deny": ["Bash(git push *)"]
  },
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-tests.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-push.sh" } ] }
    ],
    "SessionStart": [
      { "matcher": "startup", "hooks": [ { "type": "command", "command": "node --version && git log --oneline -5" } ] }
    ]
  }
}
